@@ -0,0 +1,79 @@
+"""Opt-in host lifecycle tracing for the single standalone laboratory Kasli.
+
+Lifecycle requests go over management rather than the kernel socket so that
+pauses can be marked after ndscan closes the core connection. The FPGA samples
+its own counter and emits the records. Diagnostics are best-effort: a failed
+marker never prevents an experiment from running, and is never silently retried.
+"""
+import logging
+import os
+import socket
+
+from artiq.coredevice.comm_mgmt import CommMgmt
+
+logger = logging.getLogger(__name__)
+
+START, END, PAUSE, RESUME, EXCEPTION = range(1, 6)
+
+
+class ExperimentTrace:
+    def __init__(self, host, rid):
+        self.host = host
+        self.rid = rid
+        self.active = False
+        self.started = False
+        self.finished = False
+
+    @classmethod
+    def for_worker(cls, dmgr, scheduler):
+        if os.environ.get("ARTIQ_RTIO_LIFECYCLE") != "1":
+            return None
+        # Restrict trial ownership to one explicitly designated pipeline.
+        if scheduler.pipeline_name != os.environ.get("ARTIQ_RTIO_LIFECYCLE_PIPELINE", "main"):
+            return None
+        try:
+            desc = dmgr.get_desc("core")
+            host = desc["arguments"]["host"]
+            if not host or not 0 <= scheduler.rid < 2**32:
+                return None
+        except Exception:
+            logger.warning("RTIO lifecycle unavailable: core descriptor", exc_info=True)
+            return None
+        trace = cls(host, scheduler.rid)
+        trace.active = trace.started = trace._emit(START)
+        return trace
+
+    def _emit(self, kind):
+        comm = CommMgmt(self.host)
+        try:
+            # Bound connect, handshake, send and reply waits. Do not open
+            # the kernel socket or instantiate a new core driver.
+            comm.socket = socket.create_connection((self.host, comm.port), timeout=0.25)
+            comm.socket.sendall(b"ARTIQ management\n")
+            endian = comm._read(1)
+            if endian not in (b"e", b"E"):
+                raise IOError("invalid management handshake")
+            comm.endian = "<" if endian == b"e" else ">"
+            comm.trace_boundary(kind, self.rid)
+            return True
+        except (OSError, ValueError):
+            logger.warning("RTIO lifecycle marker %d for RID %d unavailable",
+                           kind, self.rid, exc_info=True)
+            return False
+        finally:
+            comm.close()
+
+    def pause(self):
+        if self.started and self.active:
+            self._emit(PAUSE)
+            self.active = False
+
+    def resume(self):
+        if self.started and not self.finished:
+            self.active = self._emit(RESUME)
+
+    def finish(self, failed):
+        if self.started and not self.finished:
+            self._emit(EXCEPTION if failed else END)
+        self.active = False
+        self.finished = True
