diff --git a/artiq/test/test_analyzer_lifecycle.py b/artiq/test/test_analyzer_lifecycle.py
new file mode 100644
index 00000000..99a8bbf2
--- /dev/null
+++ b/artiq/test/test_analyzer_lifecycle.py
@@ -0,0 +1,80 @@
+"""Host-side wire and lifecycle checks; no connections to the lab."""
+import os
+import struct
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from artiq.coredevice.analyzer_lifecycle import ExperimentTrace
+from artiq.coredevice.comm_kernel import CommKernel
+from artiq.coredevice.core import Core
+
+
+class TestAnalyzerLifecycle(unittest.TestCase):
+    def test_exact_management_marker_wire(self):
+        trace = ExperimentTrace("test.invalid", 123456)
+        sock = Mock()
+        sock.recv.side_effect = [b"e", b"\x01"]
+        with patch("artiq.coredevice.analyzer_lifecycle.socket.create_connection",
+                   return_value=sock):
+            self.assertTrue(trace._emit(1))
+        self.assertEqual([c.args[0] for c in sock.sendall.call_args_list],
+                         [b"ARTIQ management\n", b"\x10", struct.pack("<BI", 1, 123456)])
+        sock.close.assert_called_once()
+
+    def test_worker_lifecycle_and_disabled_fallback(self):
+        dmgr = Mock()
+        dmgr.get_desc.return_value = {"arguments": {"host":"test.invalid"}}
+        scheduler = SimpleNamespace(rid=42,pipeline_name="main")
+        with patch.dict(os.environ, {"ARTIQ_RTIO_LIFECYCLE":"1",
+                                    "ARTIQ_RTIO_LIFECYCLE_PIPELINE":"main"}):
+            with patch.object(ExperimentTrace, "_emit", return_value=True) as emit:
+                trace = ExperimentTrace.for_worker(dmgr,scheduler)
+                self.assertTrue(trace.active)
+                trace.pause()
+                self.assertFalse(trace.active)
+                trace.resume()
+                self.assertTrue(trace.active)
+                trace.finish(False)
+                trace.finish(False)
+                self.assertFalse(trace.active)
+                self.assertEqual([c.args[0] for c in emit.call_args_list],[1,3,4,2])
+            with patch.object(ExperimentTrace, "_emit", return_value=False) as emit:
+                trace = ExperimentTrace.for_worker(dmgr,scheduler)
+                self.assertFalse(trace.active)
+                trace.finish(False)
+                emit.assert_called_once_with(1)
+        with patch.dict(os.environ, {"ARTIQ_RTIO_LIFECYCLE":"0"}):
+            self.assertIsNone(ExperimentTrace.for_worker(dmgr,scheduler))
+
+    def test_traced_run_request(self):
+        comm = CommKernel("test.invalid")
+        comm.open = Mock()
+        comm.endian = "<"
+        comm.pack_header = struct.Struct("<lB").pack
+        comm.socket = Mock()
+        comm.run_traced(42)
+        comm.socket.sendall.assert_called_once()
+        # sendall was passed a bytearray that is subsequently cleared. Capture
+        # the actual bytes at send time instead of inspecting that mutable object.
+        sent = []
+        comm.socket.sendall.side_effect = lambda data: sent.append(bytes(data))
+        comm.run_traced(43)
+        self.assertEqual(sent, [struct.pack("<lBI",0x5a5a5a5a,10,43)])
+
+    def test_compiled_kernel_uses_tag_only_when_active_and_matching_host(self):
+        comm = Mock()
+        comm.host = "test.invalid"
+        trace = ExperimentTrace(comm.host, 42)
+        scheduler = SimpleNamespace(rtio_trace=trace)
+        core = SimpleNamespace(first_run=False,comm=comm,
+                               dmgr=SimpleNamespace(virtual_devices={"scheduler":scheduler}))
+        Core._run_compiled(core,b"kernel",None,None,None)
+        comm.run.assert_called_once()
+        comm.run_traced.assert_not_called()
+        trace.active = True
+        Core._run_compiled(core,b"kernel",None,None,None)
+        comm.run_traced.assert_called_once_with(42)
+        trace.host = "other.invalid"
+        Core._run_compiled(core,b"kernel",None,None,None)
+        self.assertEqual(comm.run.call_count, 2)
